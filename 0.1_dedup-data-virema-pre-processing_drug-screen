# for_loop time
# REMINDER: the barcode names are listed in a .txt called		ca_reference_samples.txt	and	tx_reference_samples.txt
#	and in an earlier step, we consolidated all barcode names in2 a single .txt for simplicity		catx_reference_samples.txt
#
# expect AWK error msg's for samples that contain no virus at all i.e. mock-infection ctrls, as ViReMa doesn't output a .bed or .txt for them
#		CA09 mock-ifxn ctrls are barcodes	52 56 60
#		TX12 mock-ifxn ctrls are barcodes	40 44 48
#	if these samples have virus then you have either:
		i. contamination during wetlab, or 
		ii. "tunneling" from lax demultiplexing
#
#
# ALSO, NO NEED FOR _srun_ ... the head node easily handles these for_loops
-------------------------------------------------------------------

for file in `cat catx_reference_samples.txt`;
do
  prefix=${file%.fastq}
  
  awk -f rne_reformat_1.awk virema_output/${prefix}_1-25_RNE/${prefix}_1-25_RNE_Virus_Recombination_Results.txt | awk -F'\t' '{ for (i=3; i<=NF; i++) print $1, $2, $i }' | awk ' /_Fuzz=/ {print $2, $3, $4}'  |  sed 's/_to_/ /g'  |  sed 's/_#_/ /g'  |  awk ' {print $1, $2, $3, $4, $6 }  ' |  awk ' {print $0, sqrt(($3 - $4)^2)} '  |sort -k5,5 -k3,3n -t' '  | tee virema_output/reco_pos/${prefix}_reco_pos.txt  |  awk ' {print $1, $2, $5, $6 }  '  |   tee virema_output/reco_sorted_txtfiles/${prefix}_reco_sorted.txt   |  awk '{key=$1 OFS $2 OFS $3; data[key]=data[key] OFS $NF} END {for (k in data) print k data[k]}'  |  awk '{ for (i = 4; i <= NF; i++) if ($i !~ /^[0-9]+$/) $i = 0; for (i = NF + 1; i <= 9; i++) $i = 0 } 1' OFS="\t"  > virema_output/dvg_txtfiles/${prefix}_dvg.txt

done


